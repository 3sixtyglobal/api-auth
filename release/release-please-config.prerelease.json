{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"description": "Auto-Generated Release Please configuration for prerelease",
	"pull-request-title-pattern": "chore: prerelease release prepared",
	"group-pull-request-title-pattern": "chore: release ${branch} [skip ci]",
	"pull-request-header": "chore: prerelease release prepared",
	"pull-request-footer": "This PR was generated by the Release Next GHA",
	"release-type": "node",
	"initial-version": "0.0.1",
	"versioning": "prerelease",
	"prerelease": true,
	"prerelease-type": "next",
	"packages": {
		"packages/api-auth-models": {
			"package-name": "api-auth-models",
			"changelog-path": "docs/changelog.md"
		},
		"packages/api-auth-service": {
			"package-name": "api-auth-service",
			"changelog-path": "docs/changelog.md"
		},
		"packages/api-auth-rest-client": {
			"package-name": "api-auth-rest-client",
			"changelog-path": "docs/changelog.md"
		},
		"packages/api-auth-entity-storage-models": {
			"package-name": "api-auth-entity-storage-models",
			"changelog-path": "docs/changelog.md"
		},
		"packages/api-auth-entity-storage-service": {
			"package-name": "api-auth-entity-storage-service",
			"changelog-path": "docs/changelog.md"
		},
		"packages/api-auth-entity-storage-rest-client": {
			"package-name": "api-auth-entity-storage-rest-client",
			"changelog-path": "docs/changelog.md"
		}
	},
	"plugins": [
		"node-workspace",
		{
			"type": "linked-versions",
			"groupName": "repo",
			"components": [
				"api-auth-models",
				"api-auth-service",
				"api-auth-rest-client",
				"api-auth-entity-storage-models",
				"api-auth-entity-storage-service",
				"api-auth-entity-storage-rest-client"
			]
		}
	]
}
